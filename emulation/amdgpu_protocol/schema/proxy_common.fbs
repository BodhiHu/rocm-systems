// =============================================================================
// common.fbs — Shared types and enumerations for the AMDGPU Proxy
// =============================================================================
//
// This schema defines fundamental types, enumerations, and utility tables
// shared across all AMDGPU proxy FlatBuffers schemas. It provides a
// consistent vocabulary for memory domains, GPU hardware IP types,
// context operations, virtual address operations, and error handling.
//
// These definitions are derived from the Linux kernel UAPI headers:
//   - include/uapi/drm/amdgpu_drm.h
//   - include/uapi/linux/kfd_ioctl.h
//
// All bitmask/flag fields are represented as uint32/uint64 to allow
// bitwise combinations, since FlatBuffers enums cannot be combined.
// =============================================================================

namespace AmdgpuProxy;

// -----------------------------------------------------------------------------
// GPU Hardware IP Types
// -----------------------------------------------------------------------------
// Identifies the GPU engine/IP block to which work is submitted.
// Each type corresponds to a distinct hardware queue family.
//
// Values from AMDGPU_HW_IP_* in amdgpu_drm.h
// -----------------------------------------------------------------------------
enum HwIpType : uint32 {
    /// Graphics engine — 3D rendering, rasterization
    GFX      = 0,
    /// Compute engine — GPGPU compute shaders
    COMPUTE  = 1,
    /// DMA/SDMA engine — asynchronous memory copies
    DMA      = 2,
    /// UVD — Unified Video Decoder (legacy, pre-VCN)
    UVD      = 3,
    /// VCE — Video Compression Engine (legacy, pre-VCN)
    VCE      = 4,
    /// UVD Encoder (legacy)
    UVD_ENC  = 5,
    /// VCN Decoder — Video Core Next decode
    VCN_DEC  = 6,
    /// VCN Encoder — Video Core Next encode (also decode from VCN4+)
    VCN_ENC  = 7,
    /// VCN JPEG — JPEG decode/encode engine
    VCN_JPEG = 8,
    /// VPE — Video Processing Engine
    VPE      = 9,
}

// -----------------------------------------------------------------------------
// GEM Memory Domain (bitmask values)
// -----------------------------------------------------------------------------
// Specifies where a buffer object (BO) should be allocated.
// Multiple domains can be OR'd together to express placement preferences.
//
// Values from AMDGPU_GEM_DOMAIN_* in amdgpu_drm.h
// Note: Represented as individual constants since FlatBuffers enums
// cannot be bitwise-combined. Use uint64 fields for domain masks.
// -----------------------------------------------------------------------------
enum GemDomain : uint64 {
    NONE         = 0,
    /// System memory, not GPU-accessible. May be swapped to disk.
    CPU          = 1,    // 0x1
    /// GPU-accessible system memory, mapped through GART.
    GTT          = 2,    // 0x2
    /// Local video memory (VRAM). Fastest GPU access.
    VRAM         = 4,    // 0x4
    /// Global Data Share — on-chip shared memory for shaders.
    GDS          = 8,    // 0x8
    /// Global Wave Sync — synchronization across all waves.
    GWS          = 16,   // 0x10
    /// Ordered Append — used by 3D/compute for appending data.
    OA           = 32,   // 0x20
    /// Doorbell — MMIO region for signalling user mode queues.
    DOORBELL     = 64,   // 0x40
    /// MMIO remap — special mapping for HDP flush registers.
    MMIO_REMAP   = 128,  // 0x80
}

// -----------------------------------------------------------------------------
// Context Operations
// -----------------------------------------------------------------------------
// Operations for the DRM_AMDGPU_CTX ioctl, managing GPU rendering contexts.
//
// Values from AMDGPU_CTX_OP_* in amdgpu_drm.h
// -----------------------------------------------------------------------------
enum CtxOp : uint32 {
    NONE            = 0,
    /// Allocate a new GPU context with specified priority
    ALLOC_CTX       = 1,
    /// Free a previously allocated context
    FREE_CTX        = 2,
    /// Query context state (reset status, hang count)
    QUERY_STATE     = 3,
    /// Extended query with additional flags (VRAM lost, RAS errors)
    QUERY_STATE2    = 4,
    /// Get the current stable performance state
    GET_STABLE_PSTATE = 5,
    /// Set a stable performance state for profiling
    SET_STABLE_PSTATE = 6,
}

// -----------------------------------------------------------------------------
// Virtual Address Operations
// -----------------------------------------------------------------------------
// Operations for the DRM_AMDGPU_GEM_VA ioctl, managing GPU virtual address
// space mappings for buffer objects.
//
// Values from AMDGPU_VA_OP_* in amdgpu_drm.h
// -----------------------------------------------------------------------------
enum VaOp : uint32 {
    NONE    = 0,
    /// Map a buffer object into GPU virtual address space
    MAP     = 1,
    /// Remove a mapping from GPU virtual address space
    UNMAP   = 2,
    /// Clear a virtual address range
    CLEAR   = 3,
    /// Replace an existing mapping with a new one atomically
    REPLACE = 4,
}

// -----------------------------------------------------------------------------
// Buffer Object List Operations
// -----------------------------------------------------------------------------
// Operations for the DRM_AMDGPU_BO_LIST ioctl, managing residency lists
// that group buffer objects for command submission.
//
// Values from AMDGPU_BO_LIST_OP_* in amdgpu_drm.h
// -----------------------------------------------------------------------------
enum BoListOp : uint32 {
    /// Create a new residency list from an array of BO handles
    CREATE  = 0,
    /// Destroy a previously created residency list
    DESTROY = 1,
    /// Update resource information in an existing list
    UPDATE  = 2,
}

// -----------------------------------------------------------------------------
// Command Submission Chunk IDs
// -----------------------------------------------------------------------------
// Identifies the type of data in a command submission chunk.
// Each chunk carries a different payload type (IB, fence, deps, etc.)
//
// Values from AMDGPU_CHUNK_ID_* in amdgpu_drm.h
// -----------------------------------------------------------------------------
enum ChunkId : uint32 {
    NONE                  = 0,
    /// Indirect Buffer — contains GPU commands to execute
    IB                    = 1,
    /// Fence — user fence for signaling completion
    FENCE                 = 2,
    /// Dependencies — wait for previous submissions
    DEPENDENCIES          = 3,
    /// Sync object input — wait on sync objects before execution
    SYNCOBJ_IN            = 4,
    /// Sync object output — signal sync objects after completion
    SYNCOBJ_OUT           = 5,
    /// BO handles — explicit buffer list for this submission
    BO_HANDLES            = 6,
    /// Scheduled dependencies — wait at scheduling time
    SCHEDULED_DEPENDENCIES = 7,
    /// Timeline sync object wait — wait at timeline points
    SYNCOBJ_TIMELINE_WAIT  = 8,
    /// Timeline sync object signal — signal at timeline points
    SYNCOBJ_TIMELINE_SIGNAL = 9,
    /// CP GFX shadow — shadow/CSA state for GFX preemption
    CP_GFX_SHADOW          = 10,
}

// -----------------------------------------------------------------------------
// Semaphore Operations (Hybrid-specific)
// -----------------------------------------------------------------------------
// Operations for the DRM_AMDGPU_SEM ioctl.
//
// Values from AMDGPU_SEM_OP_* in amdgpu_drm.h
// -----------------------------------------------------------------------------
enum SemOp : uint32 {
    NONE        = 0,
    CREATE_SEM  = 1,
    WAIT_SEM    = 2,
    SIGNAL_SEM  = 3,
    DESTROY_SEM = 4,
    IMPORT_SEM  = 5,
    EXPORT_SEM  = 6,
}

// -----------------------------------------------------------------------------
// VM Operations
// -----------------------------------------------------------------------------
// Operations for the DRM_AMDGPU_VM ioctl.
// Values from AMDGPU_VM_OP_* in amdgpu_drm.h
// -----------------------------------------------------------------------------
enum VmOp : uint32 {
    NONE           = 0,
    /// Reserve a VMID for exclusive use
    RESERVE_VMID   = 1,
    /// Release a reserved VMID
    UNRESERVE_VMID = 2,
}

// -----------------------------------------------------------------------------
// Scheduler Operations
// -----------------------------------------------------------------------------
enum SchedOp : uint32 {
    NONE = 0,
    /// Override process-level priority
    PROCESS_PRIORITY_OVERRIDE = 1,
    /// Override context-level priority
    CONTEXT_PRIORITY_OVERRIDE = 2,
}

// -----------------------------------------------------------------------------
// Fence-to-Handle conversion targets
// -----------------------------------------------------------------------------
enum FenceToHandleType : uint32 {
    GET_SYNCOBJ        = 0,
    GET_SYNCOBJ_FD     = 1,
    GET_SYNC_FILE_FD   = 2,
}

// -----------------------------------------------------------------------------
// User Queue Operations
// -----------------------------------------------------------------------------
enum UserqOp : uint32 {
    NONE         = 0,
    /// Create a new user-mode queue
    USERQ_CREATE = 1,
    /// Free a user-mode queue
    USERQ_FREE   = 2,
}

// -----------------------------------------------------------------------------
// GEM Metadata Operations
// -----------------------------------------------------------------------------
enum GemMetadataOp : uint32 {
    NONE         = 0,
    SET_METADATA = 1,
    GET_METADATA = 2,
}

// -----------------------------------------------------------------------------
// GEM Operations
// -----------------------------------------------------------------------------
enum GemOpType : uint32 {
    GET_GEM_CREATE_INFO = 0,
    SET_PLACEMENT       = 1,
    GET_MAPPING_INFO    = 2,
}

// -----------------------------------------------------------------------------
// DGMA Operations (Hybrid-specific)
// -----------------------------------------------------------------------------
enum DgmaOp : uint32 {
    IMPORT          = 0,
    QUERY_PHYS_ADDR = 1,
}

// -----------------------------------------------------------------------------
// KFD Queue Types
// -----------------------------------------------------------------------------
// Queue types for KFD compute queue creation.
// Values from KFD_IOC_QUEUE_TYPE_* in kfd_ioctl.h
// -----------------------------------------------------------------------------
enum KfdQueueType : uint32 {
    /// Standard compute queue
    KFD_COMPUTE     = 0,
    /// SDMA (System DMA) queue
    KFD_SDMA        = 1,
    /// AQL (Architected Queuing Language) compute queue
    KFD_COMPUTE_AQL = 2,
    /// SDMA over XGMI interconnect
    KFD_SDMA_XGMI   = 3,
    /// SDMA by specific engine ID
    KFD_SDMA_BY_ENG = 4,
}

// -----------------------------------------------------------------------------
// KFD Memory Allocation Flags (bitmask)
// -----------------------------------------------------------------------------
// Used as uint32 bitmask in allocation requests.
// Values from KFD_IOC_ALLOC_MEM_FLAGS_* in kfd_ioctl.h
// Stored as uint32 in request tables; individual bit constants:
//   VRAM=0x1, GTT=0x2, USERPTR=0x4, DOORBELL=0x8, MMIO_REMAP=0x10
//   WRITABLE=0x80000000, EXECUTABLE=0x40000000, PUBLIC=0x20000000
//   NO_SUBSTITUTE=0x10000000, AQL_QUEUE_MEM=0x08000000
//   COHERENT=0x04000000, UNCACHED=0x02000000
//   EXT_COHERENT=0x01000000, CONTIGUOUS=0x00800000
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// KFD Event Types
// -----------------------------------------------------------------------------
enum KfdEventType : uint32 {
    SIGNAL              = 0,
    NODECHANGE          = 1,
    DEVICESTATECHANGE   = 2,
    HW_EXCEPTION        = 3,
    SYSTEM_EVENT        = 4,
    DEBUG_EVENT         = 5,
    PROFILE_EVENT       = 6,
    QUEUE_EVENT         = 7,
    MEMORY              = 8,
}

// -----------------------------------------------------------------------------
// KFD Cache Policy
// -----------------------------------------------------------------------------
enum KfdCachePolicy : uint32 {
    COHERENT    = 0,
    NONCOHERENT = 1,
}

// -----------------------------------------------------------------------------
// KFD CRIU Operations
// -----------------------------------------------------------------------------
enum KfdCriuOp : uint32 {
    PROCESS_INFO = 0,
    CHECKPOINT   = 1,
    UNPAUSE      = 2,
    RESTORE      = 3,
    RESUME       = 4,
}

// -----------------------------------------------------------------------------
// KFD SVM Operations
// -----------------------------------------------------------------------------
enum KfdSvmOp : uint32 {
    SET_ATTR = 0,
    GET_ATTR = 1,
}

// =============================================================================
// Utility Types
// =============================================================================

// -----------------------------------------------------------------------------
// Fixed-length string types
// -----------------------------------------------------------------------------
// Zero-terminated strings stored inline as structs for maximum efficiency.
// Each Str<N> holds up to N characters plus a null terminator.
// Use the smallest type that fits the field's actual data.
// -----------------------------------------------------------------------------

/// Fixed-length string: up to 15 characters + null terminator (16 bytes).
struct Str15 {
    /// String data with null terminator.
    data : [ubyte:16];
}

/// Fixed-length string: up to 31 characters + null terminator (32 bytes).
struct Str31 {
    /// String data with null terminator.
    data : [ubyte:32];
}

/// Fixed-length string: up to 63 characters + null terminator (64 bytes).
struct Str63 {
    /// String data with null terminator.
    data : [ubyte:64];
}

/// Fixed-length string: up to 255 characters + null terminator (256 bytes).
struct Str255 {
    /// String data with null terminator.
    data : [ubyte:256];
}

// -----------------------------------------------------------------------------
// RpcCtx — Per-request context carried in every RPC request
// -----------------------------------------------------------------------------
// Contains the request ID for matching and originator identity.
// Defined as a FlatBuffers struct (fixed-size, inline) for efficiency.
// -----------------------------------------------------------------------------
struct RpcCtx {
    /// Unique monotonically-increasing ID for request/response matching.
    request_id : uint64;
    /// Process ID of the originating process.
    pid : uint32;
    /// Thread ID of the originating thread.
    tid : uint32;
}

// -----------------------------------------------------------------------------
// Error — Returned when an operation fails
// -----------------------------------------------------------------------------
// Carries a POSIX errno-style error code and an optional human-readable
// message for diagnostics.
// -----------------------------------------------------------------------------
table Error {
    /// POSIX errno value (e.g., EINVAL=22, ENOMEM=12, ENODEV=19)
    code    : int32;
    /// Optional human-readable error description
    message : Str255;
}

// -----------------------------------------------------------------------------
// BufferPayload — Opaque byte array for variable-size data
// -----------------------------------------------------------------------------
// Used to carry raw kernel data blobs (e.g., INFO query results,
// metadata, firmware data) that have variable or opaque formats.
// -----------------------------------------------------------------------------
table BufferPayload {
    /// Raw byte data
    data : [ubyte];
}
