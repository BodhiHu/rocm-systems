include "common.fbs";
include "simulator.fbs";

namespace mirage.socket;


table TimeRequest {
    session_id: string;
}

table HealthRequest {
    session_id: string;
}


table HealthReply {
    healthy : bool;
    status : mirage.fb.HealthStatus;
}

table TimeReply {
    time: mirage.fb.Time (required);
}



table AttachRequest {
    run_id: string;
    
    /// data to send to the run's stdin. The server will read from this stream and write to the run's stdin.
    stream: mirage.fb.StreamData;
}



table AttachReply {
    data: mirage.fb.StreamData;
    exit: mirage.fb.RunExit;
}


// ---------------------------------------------------------------------------
//  Simulator registration — called by the simulator → daemon on connect
// ---------------------------------------------------------------------------

/// Sent by a simulator process when it first connects to the daemon socket.
///
/// The simulator passes its full identity and capabilities.  The daemon
/// uses this to populate the dashboard's simulator list and to match
/// `ProfileDef.simulator` names.
table RegisterSimRequest {
    info: mirage.simulator.SimulatorInfo (required);
}

/// Daemon acknowledges the registration.
table RegisterSimReply {
    /// Whether the registration was accepted.
    ok: bool;

    /// If `ok` is false, a human-readable reason.
    error: string;
}


// ---------------------------------------------------------------------------
//  Daemon RPC service
// ---------------------------------------------------------------------------

rpc_service Daemon {
    // -- General daemon RPCs (dashboard / client → daemon) --
    Health(HealthRequest) : HealthReply;
    Time(TimeRequest) : TimeReply;
    AttachRun(AttachRequest) : AttachReply (streaming: "bidi");

    // -- Simulator registration (simulator → daemon on connect) --
    RegisterSim(RegisterSimRequest) : RegisterSimReply;
}

