/// Simulator RPC service — daemon-to-simulator communication.
///
/// This schema defines the `Simulator` gRPC service and its request/reply
/// message types.  Data types shared with other schemas (SimulatorInfo,
/// CustomGpuDef, SessionHealth, SessionPerf) live in `simulator.fbs`.

include "common.fbs";
include "container.fbs";
include "simulator.fbs";

namespace mirage.simulator;


// ===========================================================================
//  Simulator-directed RPC messages (daemon → simulator)
// ===========================================================================

/// Request the list of supported GPU models.
/// Convenience for refreshing GPU availability without re-querying
/// the full SimulatorInfo.
table GetSupportedGpusRequest {}

/// Response to GetSupportedGpusRequest.
table GetSupportedGpusReply {
    gpus: [mirage.fb.GpuDef] (required);
}

/// Register a user-designed custom GPU topology.
/// Only sent to simulators that advertised `supports_custom_gpus = true`.
table SetCustomGpuRequest {
    gpu: CustomGpuDef (required);
}

/// Response to SetCustomGpuRequest.
/// Returns the newly created GpuDef on success.
table SetCustomGpuReply {
    gpu: mirage.fb.GpuDef (required);
}

/// Create a new simulation session and return the container spec.
///
/// The simulator should:
///   1. Generate any configuration files needed inside the container
///      (e.g. JSON simulation configs, FlatBuffers schemas).
///   2. Determine which host libraries need to be bind-mounted.
///   3. Compute the environment variables required for interposition
///      (e.g. LD_PRELOAD).
///   4. Return a ContainerDef that the daemon can hand directly to an
///      OCI runtime.
///
/// The simulator may allocate internal bookkeeping state keyed by
/// `session.name`.
table CreateSessionRequest {
    session: mirage.fb.SessionDef (required);
    profile: mirage.fb.ProfileDef (required);
}

/// Response to CreateSessionRequest.
/// Returns the full container specification for the OCI runtime.
table CreateSessionReply {
    container: mirage.container.ContainerDef (required);
}

/// Tear down a simulation session and release resources.
///
/// The simulator should clean up any internal state, temp files, or
/// resources associated with this session.
table DeleteSessionRequest {
    session_id: string (required);
}

/// Response to DeleteSessionRequest.  Empty on success.
table DeleteSessionReply {}

/// Query the health of a running session.
///
/// The daemon polls this periodically.  Simulators should return
/// Healthy when the simulation engine inside the container is
/// responsive and processing events.
table GetSessionHealthRequest {
    session_id: string (required);
}

/// Response to GetSessionHealthRequest.
table GetSessionHealthReply {
    health: SessionHealth (required);
}

/// Query performance counters for a running session.
///
/// Returns simulation-time vs wall-time metrics, tick counts, IPC,
/// and any simulator-specific counters.
table GetSessionPerfRequest {
    session_id: string (required);
}

/// Response to GetSessionPerfRequest.
table GetSessionPerfReply {
    perf: SessionPerf (required);
}

/// Transform a run request into a simulator-aware ExecDef.
///
/// Called by the daemon before starting every run inside a session.
/// The simulator can:
///   - Inject or override environment variables (e.g. ROCJITSU_CONFIG,
///     HSA_OVERRIDE_GFX_VERSION).
///   - Wrap or rewrite the command (e.g. prefix with a simulator launcher).
///   - Append extra arguments.
///
/// The returned ExecDef is what the daemon actually executes inside the
/// container.
table GetRunDefRequest {
    run: mirage.fb.RunDef (required);
}

/// Response to GetRunDefRequest.
/// Returns the (possibly modified) ExecDef with simulator-specific
/// env vars and command transformations applied.
table GetRunDefReply {
    exec: mirage.fb.ExecDef (required);
}


// ===========================================================================
//  Simulator RPC service
// ===========================================================================

/// RPCs that the daemon sends to a connected simulator process.
///
/// These are the reverse direction from the Daemon service in socket.fbs —
/// here the daemon is the client and the simulator is the server.
rpc_service Simulator {
    GetSupportedGpus(GetSupportedGpusRequest) : GetSupportedGpusReply;
    SetCustomGpu(SetCustomGpuRequest) : SetCustomGpuReply;
    CreateSession(CreateSessionRequest) : CreateSessionReply;
    DeleteSession(DeleteSessionRequest) : DeleteSessionReply;
    GetSessionHealth(GetSessionHealthRequest) : GetSessionHealthReply;
    GetSessionPerf(GetSessionPerfRequest) : GetSessionPerfReply;
    GetRunDef(GetRunDefRequest) : GetRunDefReply;
}
