/// Simulator plugin interface — FlatBuffer data types and RPC service.
///
/// This schema defines the data structures and the `Simulator` RPC service
/// that the daemon uses to communicate with a simulator plugin.  The
/// daemon-side `Daemon` service (registration, health, attach) lives in
/// `socket.fbs`.
///
/// A simulator is a standalone executable that the daemon spawns as a
/// child process.  On startup the simulator connects back to the daemon's
/// socket and registers itself.  All subsequent communication happens
/// over that socket using the FlatBuffer RPC service defined in
/// `socket.fbs`.
///
/// Lifecycle:
///   1. Daemon spawns the simulator executable, passing the daemon
///      socket address (e.g. via a well-known env var or CLI flag).
///   2. Simulator connects to the daemon socket and calls `RegisterSim`
///      with its `SimulatorInfo`.
///   3. The daemon may then call simulator-directed RPCs on the same
///      connection: `CreateSession`, `DeleteSession`,
///      `GetSessionHealth`, `GetSessionPerf`, `GetRunDef`,
///      `SetCustomGpu`.
///   4. When the daemon shuts down it closes the connection.  The
///      simulator should clean up and exit.

include "common.fbs";
include "container.fbs";

namespace mirage.simulator;


// ===========================================================================
//  Data types
// ===========================================================================


// ---------------------------------------------------------------------------
//  Simulator identity
// ---------------------------------------------------------------------------

/// Metadata that a simulator returns to identify itself to the daemon.
///
/// Sent in response to a `GetInfo` request.  The daemon uses this to
/// populate the dashboard's simulator list and to match
/// `ProfileDef.simulator` names.
table SimulatorInfo {
    /// A unique machine-readable identifier for this simulator,
    /// e.g. "rocjitsu", "gem5-gpu", "timing-model-x".
    /// Must be stable across versions — profiles reference this name.
    name: string (required);

    /// SemVer version string, e.g. "0.4.1".
    version: string (required);

    /// Human-readable one-liner shown in the dashboard.
    description: string;

    /// The list of GPU models this simulator can emulate out of the box.
    /// Each entry should have a unique `GpuDef.name`.
    supported_gpus: [mirage.fb.GpuDef] (required);

    /// Whether this simulator allows the user to design completely custom
    /// GPU topologies beyond the pre-defined `supported_gpus` list.
    /// When true, the dashboard will show a "Design Custom GPU" button.
    supports_custom_gpus: bool = false;

    /// The simulation modes this simulator supports.
    /// If empty, all modes defined in `SimulatorMode` are assumed supported.
    supported_modes: [mirage.fb.SimulatorMode];
}


// ---------------------------------------------------------------------------
//  Custom GPU design
// ---------------------------------------------------------------------------

/// A user-designed custom GPU topology.
///
/// Simulators that set `SimulatorInfo.supports_custom_gpus = true` must
/// handle `SetCustomGpu` requests.  The `topology_json` field carries a
/// simulator-specific topology description (e.g. rocjitsu's hierarchical
/// component tree) as a UTF-8 JSON string.
///
/// The simulator validates the JSON against its own schema, and if valid,
/// responds with a `GpuDef` that the daemon can use in profiles.
table CustomGpuDef {
    /// A human-readable name the user chose for this custom GPU,
    /// e.g. "my-cdna4-256cu".
    name: string (required);

    /// Simulator-specific topology description encoded as a JSON string.
    ///
    /// For rocjitsu this is the `topology` subtree of a simulation config
    /// (see experimental/rocjitsu/schemas/simulation_config.fbs).
    /// Other simulators define their own topology format.
    topology_json: string (required);

    /// Optional base GPU to derive from.  If set, the simulator should
    /// start with this GPU's defaults and override only the fields
    /// present in `topology_json`.
    base_gpu: string;
}


// ---------------------------------------------------------------------------
//  Session health & performance
// ---------------------------------------------------------------------------

/// Health status of a running simulation session.
///
/// Returned in a `SessionHealthReply`.  The daemon polls this
/// periodically and surfaces it in the dashboard.
table SessionHealth {
    /// The session this health report is for.
    session_id: string (required);

    /// Overall health status.  Simulators should return `Healthy` when
    /// the simulation engine is responsive and processing events.
    status: mirage.fb.HealthStatus;

    /// Wall-clock uptime since the session was created.
    uptime: mirage.fb.Time;

    /// If status is Unhealthy, a human-readable explanation.
    error_message: string;

    /// Optional structured diagnostics as a JSON string.
    /// Simulators can include whatever is useful for debugging
    /// (event queue depth, thread status, memory usage, etc.).
    diagnostics_json: string;
}

/// Performance counters for a running simulation session.
///
/// Returned in a `SessionPerfReply`.  These metrics are displayed
/// in the dashboard's session detail view and can be used for auto-scaling
/// decisions in cluster mode.
table SessionPerf {
    /// The session this perf report is for.
    session_id: string (required);

    /// Simulated time elapsed inside the simulator.
    /// For cycle-accurate simulators this reflects simulated clock ticks
    /// converted to wall-clock equivalent.
    simulated_time: mirage.fb.Time;

    /// Actual wall-clock time elapsed since session start.
    wall_time: mirage.fb.Time;

    /// Total simulation ticks (engine-specific unit).
    /// For rocjitsu this is simdojo discrete-event ticks.
    ticks: uint64;

    /// Instructions per cycle (IPC) — a measure of how efficiently
    /// the simulated GPU is executing workloads.
    /// 0.0 if the simulator does not track IPC.
    ipc: float64;

    /// Ratio of simulated time to wall time.
    /// Values > 1.0 mean the simulator runs faster than real-time.
    /// 0.0 if not applicable.
    simulation_speed: float64;

    /// Number of active simulated wavefronts / threads / contexts.
    active_contexts: uint32;

    /// Optional additional metrics as a JSON string.
    /// Simulators can expose whatever counters they have.
    extra_json: string;
}


// ===========================================================================
//  Simulator-directed RPC messages (daemon → simulator)
// ===========================================================================

/// Request the list of supported GPU models.
/// Convenience for refreshing GPU availability without re-querying
/// the full SimulatorInfo.
table GetSupportedGpusRequest {}

/// Response to GetSupportedGpusRequest.
table GetSupportedGpusReply {
    gpus: [mirage.fb.GpuDef] (required);
}

/// Register a user-designed custom GPU topology.
/// Only sent to simulators that advertised `supports_custom_gpus = true`.
table SetCustomGpuRequest {
    gpu: CustomGpuDef (required);
}

/// Response to SetCustomGpuRequest.
/// Returns the newly created GpuDef on success.
table SetCustomGpuReply {
    gpu: mirage.fb.GpuDef (required);
}

/// Create a new simulation session and return the container spec.
///
/// The simulator should:
///   1. Generate any configuration files needed inside the container
///      (e.g. JSON simulation configs, FlatBuffers schemas).
///   2. Determine which host libraries need to be bind-mounted.
///   3. Compute the environment variables required for interposition
///      (e.g. LD_PRELOAD).
///   4. Return a ContainerDef that the daemon can hand directly to an
///      OCI runtime.
///
/// The simulator may allocate internal bookkeeping state keyed by
/// `session.name`.
table CreateSessionRequest {
    session: mirage.fb.SessionDef (required);
    profile: mirage.fb.ProfileDef (required);
}

/// Response to CreateSessionRequest.
/// Returns the full container specification for the OCI runtime.
table CreateSessionReply {
    container: mirage.container.ContainerDef (required);
}

/// Tear down a simulation session and release resources.
///
/// The simulator should clean up any internal state, temp files, or
/// resources associated with this session.
table DeleteSessionRequest {
    session_id: string (required);
}

/// Response to DeleteSessionRequest.  Empty on success.
table DeleteSessionReply {}

/// Query the health of a running session.
///
/// The daemon polls this periodically.  Simulators should return
/// Healthy when the simulation engine inside the container is
/// responsive and processing events.
table GetSessionHealthRequest {
    session_id: string (required);
}

/// Response to GetSessionHealthRequest.
table GetSessionHealthReply {
    health: SessionHealth (required);
}

/// Query performance counters for a running session.
///
/// Returns simulation-time vs wall-time metrics, tick counts, IPC,
/// and any simulator-specific counters.
table GetSessionPerfRequest {
    session_id: string (required);
}

/// Response to GetSessionPerfRequest.
table GetSessionPerfReply {
    perf: SessionPerf (required);
}

/// Transform a run request into a simulator-aware ExecDef.
///
/// Called by the daemon before starting every run inside a session.
/// The simulator can:
///   - Inject or override environment variables (e.g. ROCJITSU_CONFIG,
///     HSA_OVERRIDE_GFX_VERSION).
///   - Wrap or rewrite the command (e.g. prefix with a simulator launcher).
///   - Append extra arguments.
///
/// The returned ExecDef is what the daemon actually executes inside the
/// container.
table GetRunDefRequest {
    run: mirage.fb.RunDef (required);
}

/// Response to GetRunDefRequest.
/// Returns the (possibly modified) ExecDef with simulator-specific
/// env vars and command transformations applied.
table GetRunDefReply {
    exec: mirage.fb.ExecDef (required);
}


// ===========================================================================
//  Simulator RPC service
// ===========================================================================

/// RPCs that the daemon sends to a connected simulator process.
///
/// These are the reverse direction from the Daemon service in socket.fbs —
/// here the daemon is the client and the simulator is the server.
rpc_service Simulator {
    GetSupportedGpus(GetSupportedGpusRequest) : GetSupportedGpusReply;
    SetCustomGpu(SetCustomGpuRequest) : SetCustomGpuReply;
    CreateSession(CreateSessionRequest) : CreateSessionReply;
    DeleteSession(DeleteSessionRequest) : DeleteSessionReply;
    GetSessionHealth(GetSessionHealthRequest) : GetSessionHealthReply;
    GetSessionPerf(GetSessionPerfRequest) : GetSessionPerfReply;
    GetRunDef(GetRunDefRequest) : GetRunDefReply;
}


// ===========================================================================
//  Dashboard RPC messages (dashboard → daemon)
// ===========================================================================

// ── Overview ───────────────────────────────────────────────────────────────

table GetOverviewRequest {}

table GetOverviewReply {
    simulator_count: uint32;
    profile_count: uint32;
    session_count: uint32;
}

// ── Simulators ─────────────────────────────────────────────────────────────

table ListSimulatorsRequest {}

/// Aggregated simulator info for the dashboard.
table SimulatorSummary {
    name: string;
    version: string;
    description: string;
    supported_gpus: [mirage.fb.GpuDef];
    supports_custom_gpus: bool;
    supported_modes: [mirage.fb.SimulatorMode];
    /// Number of active sessions using this simulator.
    active_session_count: uint32;
}

table ListSimulatorsReply {
    simulators: [SimulatorSummary];
}

table GetSimulatorRequest {
    name: string (required);
}

table GetSimulatorReply {
    simulator: SimulatorSummary;
}

// ── Profiles ───────────────────────────────────────────────────────────────

table ListProfilesRequest {
    /// Optional: only return profiles for this simulator.
    simulator_filter: string;
}

table ListProfilesReply {
    profiles: [mirage.fb.ProfileDef];
}

table CreateProfileRequest {
    profile: mirage.fb.ProfileDef (required);
}

table CreateProfileReply {
    ok: bool;
    error: string;
}

table DeleteProfileRequest {
    name: string (required);
}

table DeleteProfileReply {
    ok: bool;
    error: string;
}

// ── Sessions ───────────────────────────────────────────────────────────────

table ListSessionsRequest {
    /// Optional: only return sessions using this profile.
    profile_filter: string;
}

/// Compact session info for list views.
table SessionSummary {
    name: string;
    profile: string;
    simulator: string;
    image: string;
    health_status: mirage.fb.HealthStatus;
}

table ListSessionsReply {
    sessions: [SessionSummary];
}

table DashboardCreateSessionRequest {
    session: mirage.fb.SessionDef (required);
}

table DashboardCreateSessionReply {
    ok: bool;
    error: string;
}

table DashboardDeleteSessionRequest {
    name: string (required);
}

table DashboardDeleteSessionReply {
    ok: bool;
    error: string;
}

// ── Session detail ─────────────────────────────────────────────────────────

table GetSessionDetailRequest {
    name: string (required);
}

/// Full session state including health and performance counters.
table GetSessionDetailReply {
    name: string;
    profile: mirage.fb.ProfileDef;
    simulator: string;
    image: string;

    /// Current health status.
    health: mirage.fb.HealthStatus;
    /// Uptime since session creation.
    uptime: mirage.fb.Time;
    /// Error message if unhealthy.
    error_message: string;

    /// Performance counters.
    ticks: uint64;
    ipc: float64;
    simulation_speed: float64;
    active_contexts: uint32;
}


// ===========================================================================
//  Dashboard RPC service
// ===========================================================================

/// RPCs that the dashboard SPA calls on the daemon.
///
/// Exposed over gRPC-Web with JSON encoding so the browser can call
/// directly without a proxy.
rpc_service Dashboard {
    /// High-level counts for the dashboard home page.
    GetOverview(GetOverviewRequest): GetOverviewReply;

    /// List all registered simulators with summary info.
    ListSimulators(ListSimulatorsRequest): ListSimulatorsReply;

    /// Get detailed info for a single simulator.
    GetSimulator(GetSimulatorRequest): GetSimulatorReply;

    /// List profiles, optionally filtered by simulator.
    ListProfiles(ListProfilesRequest): ListProfilesReply;

    /// Create a new profile.
    CreateProfile(CreateProfileRequest): CreateProfileReply;

    /// Delete an existing profile.
    DeleteProfile(DeleteProfileRequest): DeleteProfileReply;

    /// List sessions, optionally filtered by profile.
    ListSessions(ListSessionsRequest): ListSessionsReply;

    /// Create a new session (resolves profile, calls simulator).
    CreateSession(DashboardCreateSessionRequest): DashboardCreateSessionReply;

    /// Delete an existing session.
    DeleteSession(DashboardDeleteSessionRequest): DashboardDeleteSessionReply;

    /// Get detailed session state including health and performance.
    GetSessionDetail(GetSessionDetailRequest): GetSessionDetailReply;

    // ── Runs ───────────────────────────────────────────────────────────

    /// List one-shot run records, optionally filtered by session.
    ListRuns(ListRunsRequest): ListRunsReply;

    /// Execute a one-shot command inside a session container.
    CreateRun(CreateRunRequest): CreateRunReply;

    // ── Terminals ──────────────────────────────────────────────────────

    /// List all active interactive terminal sessions.
    ListTerminals(ListTerminalsRequest): ListTerminalsReply;

    /// Create an interactive PTY terminal attached to a session container.
    CreateTerminal(CreateTerminalRequest): CreateTerminalReply;

    /// Send base64-encoded keystrokes to a terminal.
    TerminalInput(TerminalInputRequest): TerminalInputReply;

    /// Read base64-encoded output from a terminal (drains buffer).
    TerminalOutput(TerminalOutputRequest): TerminalOutputReply;

    /// Resize a terminal's PTY dimensions.
    TerminalResize(TerminalResizeRequest): TerminalResizeReply;

    /// Close and kill an interactive terminal session.
    CloseTerminal(CloseTerminalRequest): CloseTerminalReply;

    // ── Session log ────────────────────────────────────────────────────

    /// Get the docker pull/run output log for a session.
    GetSessionLog(GetSessionLogRequest): GetSessionLogReply;
}


// ===========================================================================
//  Runs — one-shot command execution inside sessions
// ===========================================================================

table ListRunsRequest {
    /// Optional: only return runs for this session.
    session_filter: string;
}

/// A record of a command that was executed inside a session container.
table RunRecord {
    /// Unique identifier for this run, e.g. "run-1".
    id: string;
    /// The session the run executed in.
    session: string;
    /// The shell command that was executed.
    command: string;
    /// Execution status: "running" or "exited".
    status: string;
    /// Process exit code (-1 if still running).
    exit_code: int;
    /// Captured stdout + stderr output.
    output: string;
}

table ListRunsReply {
    runs: [RunRecord];
}

table CreateRunRequest {
    session: string (required);
    command: string (required);
}

table CreateRunReply {
    ok: bool;
    error: string;
    run: RunRecord;
}


// ===========================================================================
//  Interactive terminals — PTY sessions into containers
// ===========================================================================

// ── Terminal types ─────────────────────────────────────────────────────────

/// Summary of an interactive terminal session.
table TerminalInfo {
    /// Unique terminal identifier, e.g. "term-1".
    id: string;
    /// The session this terminal is attached to.
    session: string;
    /// Whether the terminal process is still alive.
    alive: bool;
}

// ── Terminal RPCs ──────────────────────────────────────────────────────────

table CreateTerminalRequest {
    /// Session name whose container to exec into.
    session: string (required);
}

table CreateTerminalReply {
    ok: bool;
    error: string;
    /// The terminal id to use for subsequent input/output calls.
    id: string;
}

table TerminalInputRequest {
    /// Terminal id returned by CreateTerminal.
    id: string (required);
    /// Base64-encoded keystrokes / data to write to the PTY.
    data: string (required);
}

table TerminalInputReply {
    ok: bool;
}

table TerminalOutputRequest {
    /// Terminal id returned by CreateTerminal.
    id: string (required);
}

table TerminalOutputReply {
    /// Base64-encoded PTY output since the last read.
    data: string;
    /// Whether the terminal process is still alive.
    alive: bool;
}

table TerminalResizeRequest {
    /// Terminal id returned by CreateTerminal.
    id: string (required);
    /// Number of rows in the terminal.
    rows: uint32;
    /// Number of columns in the terminal.
    cols: uint32;
}

table TerminalResizeReply {
    ok: bool;
}

table CloseTerminalRequest {
    /// Terminal id returned by CreateTerminal.
    id: string (required);
}

table CloseTerminalReply {
    ok: bool;
}

table ListTerminalsRequest {}

table ListTerminalsReply {
    terminals: [TerminalInfo];
}


// ===========================================================================
//  Session log — docker pull / run output streamed per session
// ===========================================================================

table GetSessionLogRequest {
    /// Session name to retrieve the log for.
    name: string (required);
}

table GetSessionLogReply {
    /// Accumulated docker pull & run output.
    log: string;
    /// Current phase: "pulling", "starting", "ready", or "error".
    status: string;
}
